{
  "_note": "Layer definitions. The scheduled job resolves each entry against the live source catalogue (exact candidates first, then the match rules) and writes data/catalog.json. Edit here, never in catalog.json.",
  "sources": {
    "geomet": {
      "label": "ECCC MSC GeoMet",
      "wms": "https://geo.weather.gc.ca/geomet",
      "capabilities": "https://geo.weather.gc.ca/geomet?service=WMS&version=1.3.0&request=GetCapabilities&lang=en",
      "legend": true,
      "attribution": "Contains information licenced under the Data Server End-use Licence of Environment and Climate Change Canada"
    },
    "gibs": {
      "label": "NASA GIBS",
      "wms": "https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi",
      "capabilities": "https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi?SERVICE=WMS&REQUEST=GetCapabilities&VERSION=1.3.0",
      "legend": false,
      "attribution": "Imagery: NASA Global Imagery Browse Services (GIBS), part of NASA's Earth Science Data and Information System (ESDIS)"
    }
  },
  "layers": [
    { "id": "temp", "gridKm": 15, "label": "Temperature", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_AirTemp_2m", "GDPS.ETA_TT"],
      "match": { "name": "^GDPS[._]", "all": ["air temperature|temperature", "2 ?m|ETA_TT"], "not": ["WEonG", "dew", "anomal", "probab"] } },
    { "id": "wind", "gridKm": 15, "label": "Wind speed", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_WindSpeed_10m", "GDPS.ETA_UU"],
      "match": { "name": "^GDPS[._]", "all": ["wind", "10 ?m|ETA_UU"], "not": ["WEonG", "gust", "direction", "probab"] } },
    { "id": "gust", "gridKm": 15, "label": "Wind gusts", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_WindGust_10m", "GDPS-WEonG_15km_WindGust"],
      "match": { "name": "^GDPS", "all": ["gust"], "not": ["probab"] } },
    { "id": "precip", "gridKm": 15, "label": "Precipitation", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_Precip-Accum3h", "GDPS_15km_Precip-Accum6h", "GDPS.ETA_PR"],
      "match": { "name": "^GDPS[._]", "all": ["precip"], "not": ["WEonG", "type", "probab", "rate"] } },
    { "id": "pressure", "gridKm": 15, "label": "Sea-level pressure", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_SeaLevelPressure", "GDPS.ETA_PN"],
      "match": { "name": "^GDPS[._]", "all": ["sea level|MSL|ETA_PN"], "not": ["WEonG", "probab"] } },
    { "id": "cloud", "gridKm": 15, "label": "Cloud cover", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_TotalCloudCover", "GDPS.ETA_NT"],
      "match": { "name": "^GDPS[._]", "all": ["cloud"], "not": ["WEonG", "probab", "base", "top"] } },
    { "id": "cape", "gridKm": 15, "label": "Thunderstorm potential (CAPE)", "group": "main", "kind": "model", "model": "GDPS", "coverage": "Global",
      "source": "geomet", "candidates": ["GDPS_15km_CAPE", "GDPS.CONV_CAPE"],
      "match": { "name": "^GDPS[._]", "all": ["CAPE|convective available"], "not": ["WEonG", "probab"] } },
    { "id": "waves", "gridKm": 25, "label": "Wave height", "group": "main", "kind": "model", "model": "GDWPS", "coverage": "Global oceans",
      "source": "geomet", "candidates": ["GDWPS_25km_HTSGW", "GDWPS_25km_SignificantWaveHeight"],
      "match": { "name": "^GDWPS", "all": ["height|HTSGW|SWH"], "not": ["period", "direction", "probab", "maximum"], "notName": ["swell", "windwave", "windsea", "wind-wave"] } },
    { "id": "sst", "gridKm": 20, "label": "Ocean temperature", "group": "main", "kind": "model", "model": "GIOPS", "coverage": "Global oceans",
      "source": "geomet", "candidates": [],
      "match": { "name": "GIOPS", "all": ["temp|_TM"], "not": ["air", "anomal"], "notName": ["ice", "bottom", "anom", "footprint"] },
      "fallback": { "source": "gibs", "gridKm": 1, "candidates": ["GHRSST_L4_MUR_Sea_Surface_Temperature"], "kind": "daily", "model": "GHRSST MUR (satellite analysis)" } },
    { "id": "aq", "gridKm": 10, "label": "Air quality (PM2.5)", "group": "main", "kind": "model", "model": "RAQDPS", "coverage": "North America",
      "source": "geomet", "candidates": [],
      "match": { "name": "^RAQDPS", "all": ["PM2\\.5"], "not": ["probab", "FW"] } },
    { "id": "sat_eccc", "gridKm": 2, "label": "Satellite (GOES-East, ECCC)", "group": "main", "kind": "obs", "coverage": "Americas and Atlantic",
      "source": "geomet", "candidates": ["GOES-East_2km_DayNightCloudMicroCombo", "GOES-East_2km_NightIR", "GOES-East_1km_DayVis"],
      "match": { "name": "^GOES-East", "any": ["DayNight|NightIR|IR|Infrared"] } },
    { "id": "sat_ir", "gridKm": 2, "label": "Satellite infrared (global)", "group": "main", "kind": "obs", "coverage": "Global except Europe/Africa/Indian Ocean",
      "source": "gibs", "candidates": ["Himawari_AHI_Band13_Clean_Infrared", "GOES-West_ABI_Band13_Clean_Infrared", "GOES-East_ABI_Band13_Clean_Infrared"], "combine": true, "maxAgeMin": 240 },
    { "id": "truecolor", "gridKm": 0.25, "label": "True colour (daily)", "group": "main", "kind": "daily", "coverage": "Global",
      "source": "gibs", "candidates": ["VIIRS_SNPP_CorrectedReflectance_TrueColor", "MODIS_Terra_CorrectedReflectance_TrueColor"] },
    { "id": "imerg", "gridKm": 10, "label": "Rain rate (satellite, delayed)", "group": "main", "kind": "obs", "coverage": "Global (60°N–60°S), 1–2 days behind",
      "source": "gibs", "candidates": ["IMERG_Precipitation_Rate"], "maxAgeMin": 4320 },

    { "id": "radar", "gridKm": 1, "label": "Radar: rain", "group": "overlay", "kind": "obs", "coverage": "Canada and USA",
      "source": "geomet", "candidates": ["RADAR_1KM_RRAI"], "default": true },
    { "id": "radar_snow", "gridKm": 1, "label": "Radar: snow", "group": "overlay", "kind": "obs", "coverage": "Canada and USA",
      "source": "geomet", "candidates": ["RADAR_1KM_RSNO"] },
    { "id": "lightning", "gridKm": 2.5, "label": "Lightning", "group": "overlay", "kind": "obs", "coverage": "Canada (+250 km)",
      "source": "geomet", "candidates": ["Lightning_2.5km_Density"],
      "match": { "name": "lightning", "all": ["density"] } },
    { "id": "labels", "label": "Coastlines and labels", "group": "overlay", "kind": "static", "coverage": "Global",
      "source": "gibs", "candidates": ["Coastlines_15m", "Reference_Labels_15m"], "combine": true }
  ],
  "models": {
    "_note": "Open-Meteo model ids for the point comparison. The job keeps the first id that answers.",
    "gem":   { "label": "GEM (ECCC)", "candidates": ["gem_seamless", "gem_global"] },
    "ecmwf": { "label": "ECMWF IFS",  "candidates": ["ecmwf_ifs025", "ecmwf_ifs"] },
    "gfs":   { "label": "GFS (NOAA)", "candidates": ["gfs_seamless", "gfs_global"] }
  }
}
